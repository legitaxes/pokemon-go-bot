# Bot secrets — required.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
WEBHOOK_SECRET=replace-with-a-long-random-string
ALLOWED_CHAT_IDS=123456789

# Cloudflare Tunnel token — only needed when running the Dockge stack.
# Create the tunnel in Cloudflare Zero Trust → Networks → Tunnels and copy
# the connector token here. Leave blank if you're not using the cloudflared sidecar.
TUNNEL_TOKEN=
