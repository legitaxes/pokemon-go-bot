# Bot secrets — required.
TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
WEBHOOK_SECRET=replace-with-a-long-random-string
ALLOWED_CHAT_IDS=123456789

# Tailscale auth key — required when running the Dockge stack.
# Generate at https://login.tailscale.com/admin/settings/keys (Reusable + Pre-approved).
# Format: tskey-auth-<key>
TS_AUTHKEY=
